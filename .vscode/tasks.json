{
  "version": "2.0.0",

  "tasks": [

    // ============================================================
    // BUILD
    // ============================================================

    {
      "label": "West Build (auto)",
      "type": "shell",

      "group": {
        "kind": "build",
        "isDefault": true
      },

      "windows": {
        "command": "C:/Asignaturas/EMB_PLA_COM/zephyrproject/.venv/Scripts/west.exe"
      },

      "args": [
        "build",

        "-p",
        "auto",

        "-b",
        "nucleo_wl55jc",

        "C:/Users/frank/Desktop/hands_on_lab",

        "-d",
        
        "C:/Users/frank/Desktop/hands_on_lab/build",
        
        "-DZephyr-sdk_DIR=C:/Asignaturas/EMB_PLA_COM/zephyr-sdk-1.0.1/cmake",

        "-DUSER_CACHE_DIR=C:/Users/frank/Desktop/hands_on_lab/.zephyr-cache",

        "-DDTC_OVERLAY_FILE='./boards/nucleo_wl55jc.overlay'",

        "-DCONF_FILE='./confs/prj_nucleo_wl55jc.conf'",

        "-DUSE_CCACHE=0"
      ],

      "options": {
        "cwd": "C:/Asignaturas/EMB_PLA_COM/zephyrproject"
      },

      "problemMatcher": [
        "$gcc"
      ]
    },


    // ============================================================
    // FLASH
    // ============================================================

    {
      "label": "Flash (CubeProgrammer, UR+HWrst)",
      "type": "shell",

      "windows": {
        "command": "C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe"
      },

      "args": [
        "--connect",
        "port=swd",
        "mode=UR",
        "reset=HWrst",

        "--download",
        "C:\\Users\\frank\\Desktop\\hands_on_lab\\build\\zephyr\\zephyr.hex",

        "--start"
      ],

      "problemMatcher": []
    },


    // ============================================================
    // SERIAL - LIST PORTS
    // ============================================================

    {
      "label": "List COM Ports",
      "type": "shell",

      "windows": {
        "command": "powershell"
      },

      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-CimInstance Win32_SerialPort | Select-Object DeviceID, Name, Description"
      ],

      "problemMatcher": []
    },


    // ============================================================
    // SERIAL MONITOR
    // ============================================================

    {
      "label": "Serial Monitor",
      "type": "shell",

      "windows": {
        "command": "C:\\ProgramData\\chocolatey\\bin\\PLINK.EXE"
      },

      "args": [
        "-serial",
        "COM5", // Remember to change COM port to the one assigned by Windows OS to the board
        "-sercfg",
        "115200,8,n,1,N"
      ],

      "problemMatcher": []
    },


    // ============================================================
    // CLEAN BUILD
    // ============================================================

    {
      "label": "Clean Build",
      "type": "shell",

      "windows": {
        "command": "powershell"
      },

      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item -Recurse -Force \"$env:PROJECT_DIR/build\" -ErrorAction SilentlyContinue"
      ],

      "problemMatcher": []
    },


    // ============================================================
    // CLEAN CACHE
    // ============================================================

    {
      "label": "Clean Cache",
      "type": "shell",

      "windows": {
        "command": "powershell"
      },

      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item -Recurse -Force \"$env:PROJECT_DIR/.zephyr-cache\" -ErrorAction SilentlyContinue"
      ],

      "problemMatcher": []
    },


    // ============================================================
    // DEBUG SERVER
    //
    // 1. Compila
    // 2. Ejecuta west debugserver sobre ESE build
    // 3. Espera a que OpenOCD abra :3333
    // ============================================================

{
  "label": "Zephyr: Debug Server",
  "type": "shell",

  "windows": {
    "command": "C:/Asignaturas/EMB_PLA_COM/zephyrproject/.venv/Scripts/west.exe"
  },

  "args": [
    "debugserver",
    "-d",
    "C:/Users/frank/Desktop/hands_on_lab/build"
  ],

  "options": {
    "cwd": "C:/Asignaturas/EMB_PLA_COM/zephyrproject"
  },

  "dependsOn": [
    "West Build (auto)"
  ],

  "dependsOrder": "sequence",

  "isBackground": true,

  "problemMatcher": {
    "owner": "zephyr-debug",

    "pattern": {
      "regexp": "^(.*)$",
      "message": 1
    },

    "background": {
      "activeOnStart": true,
      "endsPattern": "OpenOCD GDB server running on port 3333.*"
    }
  },

  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  }
},



    // ============================================================
    // STOP OPENOCD
    // ============================================================

    {
      "label": "Zephyr: Stop Debug Server",
      "type": "shell",

      "windows": {
        "command": "taskkill"
      },

      "args": [
        "/F",
        "/IM",
        "openocd.exe"
      ],

      "problemMatcher": [],

      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }

  ]
}