#include <zephyr/dt-bindings/gpio/gpio.h>

/*------------CONFIGURACIÓN DEL ADC------------*/

&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

/*------------CONFIGURACIÓN DEL LED RGB------------*/

/ {
    rgb_leds {
        compatible = "gpio-leds";

        rgb_red: rgb_red {
            gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>; //D15
        };

        rgb_green: rgb_green {
            gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>; //
        };

        rgb_blue: rgb_blue {
            gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>; 
        };
    };

    /*------------CONFIGURACIÓN DEL SENSOR ANALÓGICO------------*/

    analog_in_pin: analog_in_pin {
        io-channels = <&adc1 5>;
    };

    /*------------ ALIASES ------------ */

    aliases {
        analog-in-pin = &analog_in_pin;

        red-led = &rgb_red;
        green-led = &rgb_green;
        blue-led = &rgb_blue;
    };
};